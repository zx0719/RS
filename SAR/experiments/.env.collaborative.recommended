# 本地小模型优先用于离线/上星前验收。若改用 vLLM/API 模式，清空
# SAR_SMALL_LLM_PATH 并设置 SAR_SMALL_LLM_URL。
SAR_SMALL_LLM_PATH=/mnt/data/zhuxiang/Qwen/Qwen3-4B
SAR_SMALL_LLM_MODEL=qwen3-4b
# SAR_SMALL_LLM_URL=http://127.0.0.1:8100/v1

SAR_LARGE_LLM_URL=
SAR_LARGE_LLM_MODEL=Qwen2.5-72B-Instruct

# 启动 scripts/start_vllm_vlm.sh 后可打开严格 VLM 验收。
SAR_VLM_URL=
# SAR_VLM_URL=http://127.0.0.1:8101/v1
SAR_VLM_MODEL=qwen3-vl-4b
SAR_REQUIRE_VLM=0

SAR_LLM_API_KEY=EMPTY
SAR_LLM_TIMEOUT=60
SAR_LLM_DEVICE=cuda:0
SAR_LLM_MAX_NEW_TOKENS=256
SAR_REQUIRE_GPU=1
SAR_REQUIRE_LOCAL_GPU=1
# 上星验收不接受模板兜底；离线开发调试可临时改为 1。
SAR_ALLOW_TEMPLATE_FALLBACK=0

SAR_ROUTE_LARGE_REFINE_CLASS_THRESHOLD=2
SAR_ROUTE_LARGE_REFINE_OBJECT_THRESHOLD=20
SAR_ROUTE_LARGE_REFINE_REVIEW_THRESHOLD=2
SAR_ROUTE_LARGE_MODEL_CLUSTER_THRESHOLD=12
SAR_ROUTE_LARGE_MODEL_CLASS_THRESHOLD=3
SAR_ROUTE_LARGE_MODEL_OBJECT_THRESHOLD=80
SAR_ROUTE_LARGE_MODEL_REVIEW_THRESHOLD=10
SAR_ROUTE_LARGE_MODEL_LOW_CONF_RATIO=0.28
