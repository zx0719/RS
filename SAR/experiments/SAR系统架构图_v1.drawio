        </mxCell>

        <mxCell id="m2_det" value="&lt;b&gt;YOLOv8-OBB 检测器&lt;/b&gt;&#xa;modules/detector/detector.py&#xa;• 旋转框目标检测（5类）&#xa;• ship / aircraft / tank&#xa;  bridge / harbor&#xa;• 输出 objects[].geometry.pixel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="230" y="410" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="m2_geo" value="&lt;b&gt;GDAL 坐标地理化&lt;/b&gt;&#xa;modules/geo/geolocalize.py&#xa;• 像素坐标 → WGS84经纬度&#xa;• 仿射变换 + CRS投影&#xa;• 输出 objects[].geometry.geo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="530" y="410" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="m2_stat" value="&lt;b&gt;统计汇总&lt;/b&gt;&#xa;modules/evidence/builder.py&#xa;• 按类计数（by_class）&#xa;• 总目标数（totals）&#xa;• 置信度分布统计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="830" y="410" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="m2_vis" value="&lt;b&gt;可视化标注&lt;/b&gt;&#xa;modules/detector/visualize.py&#xa;• OBB旋转框绘制&#xa;• 按super_class着色&#xa;• 输出 *_annotated.jpg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1130" y="410" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="arr_m2_m3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;strokeWidth=2;" edge="1" parent="1" source="m2_bg" target="m3">
