        <mxCell id="status_box" value="&lt;b&gt;Evidence 状态机&lt;/b&gt;&#xa;RECEIVED&#xa;↓ PREPROCESSED&#xa;↓ DETECTED&#xa;↓ GEOLOCATED&#xa;↓ FUSED&#xa;↓ READY_FOR_NLG&#xa;↓ REPORT_DRAFTED&#xa;↓ DOCX_RENDERED&#xa;↓ REVIEW_PENDING&#xa;↓ COMPLETED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;fontColor=#333333;" vertex="1" parent="1">
