        <!-- ══════════════════════════════════════════════════════ -->
        <!-- 设计原则说明框 -->
        <!-- ══════════════════════════════════════════════════════ -->
        <mxCell id="principle_box" value="&lt;b&gt;核心设计原则&lt;/b&gt;&#xa;─────────────────────&#xa;① 事实由工具给出&#xa;   文字由模型组织&#xa;─────────────────────&#xa;② 结构化证据防幻觉&#xa;   LLM只读JSON不推断&#xa;─────────────────────&#xa;③ 模块解耦&#xa;   检测器/LLM/模板&#xa;   可独立替换" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;fontColor=#333333;" vertex="1" parent="1">
