        <!-- M3 证据融合层 -->
        <!-- ══════════════════════════════════════════════════════ -->
        <mxCell id="m3" value="&lt;b&gt;[M3] 证据融合层&lt;/b&gt;　modules/evidence/builder.py&#xa;• 检测结果 + 坐标 + 元数据 → 标准 Evidence Package JSON（schema v1.0）&#xa;• 状态机推进：DETECTED → GEOLOCATED → FUSED → READY_FOR_NLG&#xa;• 一致性预检（数量/坐标/类别自洽）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="350" y="610" width="860" height="80" as="geometry" />
        </mxCell>

        <!-- Evidence JSON 侧边说明 -->
        <mxCell id="evidence_box" value="&lt;b&gt;Evidence Package JSON&lt;/b&gt;&#xa;schema v1.0&#xa;─────────────────&#xa;input.metadata&#xa;scene.scene_type&#xa;objects[].class&#xa;objects[].geometry.pixel&#xa;objects[].geometry.geo&#xa;objects[].score&#xa;statistics.by_class&#xa;statistics.totals&#xa;attachments.annotated_uri&#xa;report.body&#xa;report.docx_uri&#xa;quality.*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;fontColor=#333333;" vertex="1" parent="1">
