        <!-- ══════════════════════════════════════════════════════ -->
        <mxCell id="m1" value="&lt;b&gt;[M1] 预处理与元数据解析&lt;/b&gt;&#xa;modules/geo/preprocess.py&#xa;• 图像格式归一化（GeoTIFF→内存）&#xa;• GDAL读取地理参考（CRS / Transform）&#xa;• 元数据结构化（卫星/时间/GSD/极化）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="240" width="560" height="80" as="geometry" />
        </mxCell>

        <mxCell id="arr_m1_m2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;strokeWidth=2;" edge="1" parent="1" source="m1" target="m2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- M2 感知工具层 -->
        <!-- ══════════════════════════════════════════════════════ -->
        <mxCell id="m2_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="200" y="380" width="1200" height="160" as="geometry" />
